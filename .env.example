# Скопируйте в .env и задайте свои значения

# Имя хаба и ключ для входа в веб-интерфейс (/login)
HUB_NAME=my-hub
HUB_KEY=change-me-to-a-long-random-secret

# Порт hub на хосте (без Caddy)
HUB_PORT=8080

# Версия Docker-образа hub (тег на ghcr.io). По умолчанию — latest
# VERSION=0.0.20

# Домен для HTTPS (профиль domain в docker compose)
DOMAIN=monitor.example.com

# Базовый URL ntfy для push-уведомлений (по умолчанию https://ntfy.sh)
# NTFY_BASE_URL=https://ntfy.sh
# Публичный URL ntfy для агентов/телефонов (если BASE — внутренний docker URL)
# NTFY_PUBLIC_URL=https://ntfy.ваш-домен.ru
