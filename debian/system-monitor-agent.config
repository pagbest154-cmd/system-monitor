#!/bin/sh
set -e

. /usr/share/debconf/confmodule

db_capb backup

# Preseed from environment (non-interactive: HUB_URL=... AGENT_TOKEN=... apt install ...)
if [ -n "${HUB_URL:-}" ]; then
	db_set system-monitor-agent/hub-url "$HUB_URL"
fi
if [ -n "${AGENT_ID:-}" ]; then
	db_set system-monitor-agent/agent-id "$AGENT_ID"
fi
if [ -n "${AGENT_TOKEN:-}" ]; then
	db_set system-monitor-agent/token "$AGENT_TOKEN"
fi

SEED_FILE="/run/system-monitor-agent/debconf.seed"

# $2 is not reliable across apt/dpkg versions; use package status.
should_write_install_seed() {
	if [ -n "${DPKG_RECONFIGURE:-}" ] || [ -n "${DEBCONF_RECONFIGURE:-}" ]; then
		return 0
	fi
	status="$(dpkg-query -W -f='${Status}' system-monitor-agent 2>/dev/null || true)"
	case "$status" in
	"install ok installed") return 1 ;;
	esac
	return 0
}

write_install_seed() {
	db_get system-monitor-agent/hub-url || true
	hub="${RET:-}"
	db_get system-monitor-agent/agent-id || true
	agent_id="${RET:-}"
	db_get system-monitor-agent/token || true
	token="${RET:-}"
	umask 077
	mkdir -p /run/system-monitor-agent
	{
		printf 'hub_url=%s\n' "$hub"
		printf 'agent_id=%s\n' "$agent_id"
	} >"$SEED_FILE"
	if [ -n "$token" ]; then
		printf '%s' "$token" | base64 -w0 >"${SEED_FILE}.token.b64"
	fi
	chmod 600 "$SEED_FILE" "${SEED_FILE}.token.b64" 2>/dev/null || chmod 600 "$SEED_FILE"
}

# dpkg -i may run this script after postinst; apply seed if shipped template is still on disk.
apply_seed_if_postinst_missed() {
	AGENT_YAML="/etc/system-monitor/agent.yaml"
	TOKEN_FILE="/etc/system-monitor/agent.token"
	if [ ! -f "$SEED_FILE" ] || [ ! -f "$AGENT_YAML" ]; then
		return 0
	fi
	if ! grep -q 'agent_id: "local-agent"' "$AGENT_YAML" 2>/dev/null; then
		return 0
	fi
	hub_url=""
	agent_id=""
	seed_token=""
	set -a
	# shellcheck disable=SC1090
	. "$SEED_FILE"
	set +a
	hub_url="${hub_url:-}"
	agent_id="${agent_id:-}"
	if [ -f "${SEED_FILE}.token.b64" ]; then
		seed_token="$(base64 -d "${SEED_FILE}.token.b64" 2>/dev/null || true)"
	fi
	rm -f "$SEED_FILE" "${SEED_FILE}.token.b64"
	if [ -z "$hub_url" ]; then
		hub_url="http://127.0.0.1:8080"
	fi
	if [ -z "$agent_id" ]; then
		agent_id="$(hostname)"
	fi
	cat >"$AGENT_YAML" <<EOF
hub_url: "$hub_url"
agent_id: "$agent_id"
token_file: $TOKEN_FILE
interval_sec: 5
transport: http
EOF
	chmod 0644 "$AGENT_YAML"
	if [ -n "$seed_token" ]; then
		umask 077
		printf '%s' "$seed_token" >"$TOKEN_FILE"
		chown system-monitor-agent:system-monitor-agent "$TOKEN_FILE" 2>/dev/null || true
		chmod 0600 "$TOKEN_FILE"
	elif [ ! -f "$TOKEN_FILE" ]; then
		touch "$TOKEN_FILE"
		chown system-monitor-agent:system-monitor-agent "$TOKEN_FILE" 2>/dev/null || true
		chmod 0600 "$TOKEN_FILE"
	fi
}

ask() {
	question="$1"
	priority="$2"
	# Always present the question. Skipping when db_get is non-empty hides hub-url
	# because its template Default is pre-filled (127.0.0.1) without user input.
	db_input "$priority" "$question" || true
	while true; do
		if db_go; then
			return 0
		fi
		db_input "$priority" "$question" || true
	done
}

AGENT_YAML="/etc/system-monitor/agent.yaml"
TOKEN_FILE="/etc/system-monitor/agent.token"

is_package_installed() {
	status="$(dpkg-query -W -f='${Status}' system-monitor-agent 2>/dev/null || true)"
	case "$status" in
	"install ok installed") return 0 ;;
	esac
	return 1
}

yaml_quoted_field() {
	field="$1"
	file="$2"
	sed -n "s/^${field}:[[:space:]]*[\"']\\([^\"']*\\)[\"'].*/\\1/p" "$file" 2>/dev/null | head -n 1
}

agent_configured_on_disk() {
	if [ ! -f "$AGENT_YAML" ] || [ ! -s "$TOKEN_FILE" ]; then
		return 1
	fi
	if grep -q 'agent_id: "local-agent"' "$AGENT_YAML" 2>/dev/null; then
		return 1
	fi
	return 0
}

should_skip_debconf_questions() {
	if [ -n "${DPKG_RECONFIGURE:-}" ] || [ -n "${DEBCONF_RECONFIGURE:-}" ]; then
		return 1
	fi
	if ! is_package_installed; then
		return 1
	fi
	if agent_configured_on_disk; then
		return 0
	fi
	return 1
}

sync_debconf_from_disk() {
	hub="$(yaml_quoted_field hub_url "$AGENT_YAML")"
	agent_id="$(yaml_quoted_field agent_id "$AGENT_YAML")"
	token="$(cat "$TOKEN_FILE" 2>/dev/null || true)"
	if [ -n "$hub" ]; then
		db_set system-monitor-agent/hub-url "$hub"
	fi
	if [ -n "$agent_id" ]; then
		db_set system-monitor-agent/agent-id "$agent_id"
	fi
	if [ -n "$token" ]; then
		db_set system-monitor-agent/token "$token"
	fi
}

case "$1" in
	configure)
		if should_skip_debconf_questions; then
			sync_debconf_from_disk
		else
			ask system-monitor-agent/hub-url critical
			ask system-monitor-agent/agent-id critical
			ask system-monitor-agent/token critical

			# postinst runs after unpack; pass answers via seed (db_get in postinst is unreliable).
			if should_write_install_seed; then
				write_install_seed
				apply_seed_if_postinst_missed
			fi
		fi
		;;
esac
