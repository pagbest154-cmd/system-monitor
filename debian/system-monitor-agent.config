#!/bin/sh
set -e

. /usr/share/debconf/confmodule

db_capb backup

# Preseed from environment (non-interactive: HUB_URL=... AGENT_TOKEN=... apt install ...)
if [ -n "${HUB_URL:-}" ]; then
	db_set system-monitor-agent/hub-url "$HUB_URL"
fi
if [ -n "${AGENT_ID:-}" ]; then
	db_set system-monitor-agent/agent-id "$AGENT_ID"
fi
if [ -n "${AGENT_TOKEN:-}" ]; then
	db_set system-monitor-agent/token "$AGENT_TOKEN"
fi

SEED_FILE="/run/system-monitor-agent/debconf.seed"

write_install_seed() {
	db_get system-monitor-agent/hub-url || true
	hub="${RET:-}"
	db_get system-monitor-agent/agent-id || true
	agent_id="${RET:-}"
	db_get system-monitor-agent/token || true
	token="${RET:-}"
	umask 077
	mkdir -p /run/system-monitor-agent
	{
		printf 'hub_url=%s\n' "$hub"
		printf 'agent_id=%s\n' "$agent_id"
	} >"$SEED_FILE"
	if [ -n "$token" ]; then
		printf '%s' "$token" | base64 -w0 >"${SEED_FILE}.token.b64"
	fi
	chmod 600 "$SEED_FILE" "${SEED_FILE}.token.b64" 2>/dev/null || chmod 600 "$SEED_FILE"
}

ask() {
	question="$1"
	priority="$2"
	db_get "$question" || true
	if [ -n "${RET:-}" ]; then
		return 0
	fi
	db_input "$priority" "$question" || true
	while true; do
		if db_go; then
			return 0
		fi
		db_input "$priority" "$question" || true
	done
}

case "$1" in
	configure)
		# $2 empty = first install (not upgrade). Clear stale debconf so all prompts show.
		if [ -z "$2" ]; then
			if [ -z "${HUB_URL:-}" ]; then
				db_set system-monitor-agent/hub-url ""
			fi
			if [ -z "${AGENT_ID:-}" ]; then
				db_set system-monitor-agent/agent-id ""
			fi
			if [ -z "${AGENT_TOKEN:-}" ]; then
				db_set system-monitor-agent/token ""
			fi
		fi

		ask system-monitor-agent/hub-url critical
		ask system-monitor-agent/agent-id critical
		ask system-monitor-agent/token critical

		# postinst runs after unpack; debconf db_get there is unreliable on first install.
		if [ -z "$2" ]; then
			write_install_seed
		elif [ -n "${DPKG_RECONFIGURE:-}" ] || [ -n "${DEBCONF_RECONFIGURE:-}" ]; then
			write_install_seed
		fi
		;;
esac
