#!/bin/sh
set -e

. /usr/share/debconf/confmodule

db_capb backup

# Preseed from environment (non-interactive: HUB_URL=... AGENT_TOKEN=... apt install ...)
if [ -n "${HUB_URL:-}" ]; then
	db_set system-monitor-agent/hub-url "$HUB_URL"
fi
if [ -n "${AGENT_ID:-}" ]; then
	db_set system-monitor-agent/agent-id "$AGENT_ID"
fi
if [ -n "${AGENT_TOKEN:-}" ]; then
	db_set system-monitor-agent/token "$AGENT_TOKEN"
fi

ask() {
	question="$1"
	priority="$2"
	db_get "$question" || true
	if [ -n "${RET:-}" ]; then
		return 0
	fi
	db_input "$priority" "$question" || true
	while true; do
		if db_go; then
			return 0
		fi
		db_input "$priority" "$question" || true
	done
}

case "$1" in
	configure)
		db_get system-monitor-agent/agent-id || true
		if [ -z "${RET:-}" ]; then
			db_set system-monitor-agent/agent-id "$(hostname)"
		fi

		ask system-monitor-agent/hub-url critical
		ask system-monitor-agent/agent-id critical
		ask system-monitor-agent/token critical
		;;
esac
