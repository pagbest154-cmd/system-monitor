#!/bin/sh
set -e

. /usr/share/debconf/confmodule

db_capb backup

ask() {
    question="$1"
    priority="$2"
    db_input "$priority" "$question" || true
    while true; do
        if db_go; then
            return 0
        fi
        db_input "$priority" "$question" || true
    done
}

case "$1" in
    configure)
        if [ -z "$2" ]; then
            db_fset system-monitor-agent/hub-url seen false
            db_fset system-monitor-agent/agent-id seen false
            db_fset system-monitor-agent/token seen false
        fi

        db_get system-monitor-agent/agent-id || true
        if [ -z "${RET:-}" ]; then
            db_set system-monitor-agent/agent-id "$(hostname)"
        fi

        ask system-monitor-agent/hub-url critical
        ask system-monitor-agent/agent-id critical
        ask system-monitor-agent/token critical
        ;;
esac
