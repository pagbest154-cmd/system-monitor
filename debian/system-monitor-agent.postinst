#!/bin/sh
set -e

AGENT_YAML="/etc/system-monitor/agent.yaml"
TOKEN_FILE="/etc/system-monitor/agent.token"
SEED_FILE="/run/system-monitor-agent/debconf.seed"

agent_yaml_is_configured() {
    if [ ! -s "$AGENT_YAML" ]; then
        return 1
    fi
    if grep -qE 'agent_id:\s*"(local-agent|)"' "$AGENT_YAML" 2>/dev/null; then
        return 1
    fi
    if grep -q 'change-me' "$AGENT_YAML" 2>/dev/null; then
        return 1
    fi
    hub="$(grep -E '^hub_url:' "$AGENT_YAML" 2>/dev/null | sed 's/^hub_url:\s*//' | tr -d '"')" || true
    if [ -z "$hub" ] || [ "$hub" = "http://127.0.0.1:8080" ]; then
        return 1
    fi
    return 0
}

should_apply_install_config() {
    if [ -f "$SEED_FILE" ]; then
        return 0
    fi
    case "${2:-}" in
    ""|-) return 0 ;;
    esac
    status="$(dpkg-query -W -f='${Status}' system-monitor-agent 2>/dev/null || true)"
    case "$status" in
    "install ok unpacked" | "install ok half-configured") return 0 ;;
    esac
    return 1
}

load_hub_agent_from_debconf() {
    hub_url=""
    agent_id=""
    seed_token=""
    if [ -f "$SEED_FILE" ]; then
        # shellcheck disable=SC1090
        set -a
        . "$SEED_FILE"
        set +a
        hub_url="${hub_url:-}"
        agent_id="${agent_id:-}"
        if [ -f "${SEED_FILE}.token.b64" ]; then
            seed_token="$(base64 -d "${SEED_FILE}.token.b64" 2>/dev/null || true)"
            rm -f "${SEED_FILE}.token.b64"
        fi
        rm -f "$SEED_FILE"
        if [ -n "$seed_token" ]; then
            token="$seed_token"
        fi
        return 0
    fi
    if [ -f /usr/share/debconf/confmodule ]; then
        . /usr/share/debconf/confmodule
        db_get system-monitor-agent/hub-url || true
        hub_url="${RET:-}"
        db_get system-monitor-agent/agent-id || true
        agent_id="${RET:-}"
    fi
}

write_agent_yaml() {
    hub_url="${1:-http://127.0.0.1:8080}"
    agent_id="${2:-}"
    token_file="${3:-/etc/system-monitor/agent.token}"

    cat >"$AGENT_YAML" <<EOF
hub_url: "$hub_url"
agent_id: "$agent_id"
token_file: $token_file
interval_sec: 5
transport: http
EOF
    chmod 0644 "$AGENT_YAML"
}

apply_agent_install_config() {
    token=""
    load_hub_agent_from_debconf
    hub_url="${HUB_URL:-$hub_url}"
    agent_id="${AGENT_ID:-$agent_id}"

    if [ -z "$token" ] && [ -f /usr/share/debconf/confmodule ]; then
        . /usr/share/debconf/confmodule
        db_get system-monitor-agent/token || true
        token="${RET:-}"
    fi
    token="${AGENT_TOKEN:-$token}"

    if [ -z "$hub_url" ]; then
        hub_url="http://127.0.0.1:8080"
        echo "system-monitor-agent: Hub URL не задан — используется $hub_url. Задайте URL: sudo dpkg-reconfigure system-monitor-agent" >&2
    fi
    if [ -z "$agent_id" ]; then
        agent_id="$(hostname)"
    fi

    write_agent_yaml "$hub_url" "$agent_id" "$TOKEN_FILE"

    if [ -n "$token" ]; then
        umask 077
        printf '%s' "$token" >"$TOKEN_FILE"
        chown system-monitor-agent:system-monitor-agent "$TOKEN_FILE"
        chmod 0600 "$TOKEN_FILE"
    elif [ ! -f "$TOKEN_FILE" ]; then
        touch "$TOKEN_FILE"
        chown system-monitor-agent:system-monitor-agent "$TOKEN_FILE"
        chmod 0600 "$TOKEN_FILE"
    fi

    if [ ! -s "$TOKEN_FILE" ]; then
        echo "system-monitor-agent: token не задан — служба не сможет подключиться к hub." >&2
        echo "Настройка: sudo dpkg-reconfigure system-monitor-agent" >&2
    fi
}

wrote_config=false

case "$1" in
    configure)
        mkdir -p /etc/system-monitor /var/lib/system-monitor-agent
        if ! getent passwd system-monitor-agent >/dev/null; then
            adduser --system --group --home /var/lib/system-monitor-agent system-monitor-agent
        fi
        chown system-monitor-agent:system-monitor-agent /var/lib/system-monitor-agent
        chmod 0750 /var/lib/system-monitor-agent

        # Fresh install / reconfigure: debconf seed or selections -> agent.yaml and token.
        # On upgrade preserve /etc/system-monitor/* (conffiles + guard below).
        if should_apply_install_config "$2" && ! agent_yaml_is_configured; then
            apply_agent_install_config
            wrote_config=true
        elif [ ! -f "$TOKEN_FILE" ]; then
            touch "$TOKEN_FILE"
            chown system-monitor-agent:system-monitor-agent "$TOKEN_FILE"
            chmod 0600 "$TOKEN_FILE"
        fi
        ;;
esac

#DEBHELPER#

# dpkg -i often runs debconf config after the main postinst body; apply seed if it appeared late.
if [ "$1" = "configure" ] && [ -f "$SEED_FILE" ] && [ "${wrote_config:-false}" != "true" ]; then
    apply_agent_install_config
    wrote_config=true
fi

if [ "$1" = "configure" ]; then
    reload_systemd() {
        if command -v deb-systemd-invoke >/dev/null; then
            deb-systemd-invoke daemon-reload >/dev/null 2>&1 || true
        fi
        systemctl daemon-reload 2>/dev/null || true
    }

    restart_agent() {
        reload_systemd
        systemctl enable system-monitor-agent.service >/dev/null 2>&1 || true
        systemctl restart system-monitor-agent.service >/dev/null 2>&1 \
            || systemctl start system-monitor-agent.service >/dev/null 2>&1 \
            || true
        if ! systemctl is-active --quiet system-monitor-agent.service 2>/dev/null; then
            reload_systemd
            systemctl restart system-monitor-agent.service >/dev/null 2>&1 \
                || systemctl start system-monitor-agent.service >/dev/null 2>&1 \
                || true
        fi
        systemctl is-active --quiet system-monitor-agent.service 2>/dev/null
    }

    start_agent() {
        reload_systemd
        systemctl start system-monitor-agent.service >/dev/null 2>&1 || true
    }

    reload_systemd

    if [ ! -s "$TOKEN_FILE" ]; then
        echo "system-monitor-agent: служба включена, но не запущена (нет token)." >&2
        echo "  sudo dpkg-reconfigure system-monitor-agent" >&2
        echo "  sudo systemctl start system-monitor-agent" >&2
    else
        is_upgrade=false
        if [ -n "${2:-}" ] && [ "$2" != "-" ]; then
            is_upgrade=true
        fi
        if [ "$is_upgrade" = "true" ] || [ "${wrote_config:-false}" = "true" ]; then
            if restart_agent; then
                if command -v system-monitor-agent >/dev/null; then
                    agent_ver="$(system-monitor-agent --version 2>/dev/null || true)"
                    if [ -n "$agent_ver" ]; then
                        echo "system-monitor-agent: перезапущен после обновления, версия ${agent_ver}." >&2
                    fi
                fi
            else
                echo "system-monitor-agent: пакет обновлён, но служба не запущена." >&2
                echo "  sudo systemctl status system-monitor-agent" >&2
                echo "  sudo systemctl start system-monitor-agent" >&2
            fi
        else
            start_agent
        fi
    fi
fi

exit 0
