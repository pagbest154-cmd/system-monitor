#!/bin/sh
set -e

AGENT_YAML="/etc/system-monitor/agent.yaml"
TOKEN_FILE="/etc/system-monitor/agent.token"

install_runtime() {
    venv="/opt/system-monitor-agent/venv"
    src="/usr/share/system-monitor-agent/src"

    if ! command -v python3 >/dev/null; then
        echo "system-monitor-agent: python3 не найден." >&2
        return 1
    fi
    if ! python3 -c "import venv" 2>/dev/null; then
        echo "system-monitor-agent: установите python3-venv." >&2
        return 1
    fi
    if ! python3 -m pip --version >/dev/null 2>&1; then
        echo "system-monitor-agent: установите python3-pip." >&2
        return 1
    fi
    if [ ! -f "$src/pyproject.toml" ]; then
        echo "system-monitor-agent: исходники пакета не найдены в $src." >&2
        return 1
    fi

    rm -rf "$venv"
    python3 -m venv "$venv"
    "$venv/bin/python3" -m pip install --no-cache-dir --upgrade pip wheel
    if ! "$venv/bin/python3" -m pip install --no-cache-dir "$src"; then
        echo "system-monitor-agent: не удалось установить зависимости (нужен интернет)." >&2
        return 1
    fi
    chown -R system-monitor-agent:system-monitor-agent /opt/system-monitor-agent
    return 0
}

write_agent_yaml() {
    hub_url="${1:-http://127.0.0.1:8080}"
    agent_id="${2:-}"
    token_file="${3:-/etc/system-monitor/agent.token}"

    cat >"$AGENT_YAML" <<EOF
hub_url: "$hub_url"
agent_id: "$agent_id"
token_file: $token_file
interval_sec: 5
transport: http
EOF
    chmod 0644 "$AGENT_YAML"
}

case "$1" in
    configure)
        if ! getent passwd system-monitor-agent >/dev/null; then
            adduser --system --group --home /var/lib/system-monitor-agent --no-create-home system-monitor-agent
        fi
        mkdir -p /etc/system-monitor /var/lib/system-monitor-agent
        chown system-monitor-agent:system-monitor-agent /var/lib/system-monitor-agent
        chmod 0750 /var/lib/system-monitor-agent

        hub_url="http://127.0.0.1:8080"
        agent_id=""
        token=""

        if [ -f /usr/share/debconf/confmodule ]; then
            . /usr/share/debconf/confmodule
            db_get system-monitor-agent/hub-url || true
            hub_url="${RET:-http://127.0.0.1:8080}"
            db_get system-monitor-agent/agent-id || true
            agent_id="${RET:-}"
            db_get system-monitor-agent/token || true
            token="${RET:-}"
        fi

        hub_url="${HUB_URL:-$hub_url}"
        agent_id="${AGENT_ID:-$agent_id}"
        token="${AGENT_TOKEN:-$token}"

        if [ -z "$agent_id" ]; then
            agent_id="$(hostname)"
        fi

        if ! install_runtime; then
            echo "Повторите после установки python3-venv python3-pip и с интернетом:" >&2
            echo "  sudo apt install python3-venv python3-pip" >&2
            echo "  sudo dpkg-reconfigure system-monitor-agent" >&2
        fi

        write_agent_yaml "$hub_url" "$agent_id" "$TOKEN_FILE"

        if [ -n "$token" ]; then
            umask 077
            printf '%s' "$token" >"$TOKEN_FILE"
            chown system-monitor-agent:system-monitor-agent "$TOKEN_FILE"
            chmod 0600 "$TOKEN_FILE"
        elif [ ! -f "$TOKEN_FILE" ]; then
            touch "$TOKEN_FILE"
            chown system-monitor-agent:system-monitor-agent "$TOKEN_FILE"
            chmod 0600 "$TOKEN_FILE"
        fi

        if [ ! -s "$TOKEN_FILE" ]; then
            echo "system-monitor-agent: token не задан — служба не сможет подключиться к hub." >&2
            echo "Настройка: sudo dpkg-reconfigure system-monitor-agent" >&2
        fi
        ;;
esac

#DEBHELPER#

exit 0
