#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        if command -v deb-systemd-helper >/dev/null; then
            deb-systemd-helper stop system-monitor-agent.service >/dev/null || true
            deb-systemd-helper disable system-monitor-agent.service >/dev/null || true
        fi
        ;;
esac

exit 0
