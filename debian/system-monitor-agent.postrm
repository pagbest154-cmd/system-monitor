#!/bin/sh
set -e

case "$1" in
    purge)
        if [ -f /usr/share/debconf/confmodule ]; then
            . /usr/share/debconf/confmodule
            db_purge system-monitor-agent/hub-url || true
            db_purge system-monitor-agent/agent-id || true
            db_purge system-monitor-agent/token || true
        fi
        rm -f /etc/system-monitor/agent.token
        rm -f /etc/system-monitor/agent.yaml
        rm -f /etc/system-monitor/agent_sensors.yaml
        rmdir /etc/system-monitor 2>/dev/null || true
        rm -rf /run/system-monitor-agent
        ;;
esac

#DEBHELPER#

exit 0
