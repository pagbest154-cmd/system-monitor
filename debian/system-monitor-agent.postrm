#!/bin/sh
set -e

case "$1" in
    purge)
        if command -v deb-systemd-helper >/dev/null; then
            deb-systemd-helper purge system-monitor-agent.service >/dev/null || true
        fi
        if [ -f /usr/share/debconf/confmodule ]; then
            . /usr/share/debconf/confmodule
            db_purge system-monitor-agent/hub-url || true
            db_purge system-monitor-agent/agent-id || true
            db_purge system-monitor-agent/token || true
        fi
        ;;
esac

exit 0
