[Unit]
Description=system-monitor — web-based system monitoring
Documentation=https://github.com/pagbest154-cmd/system-monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=system-monitor
Group=system-monitor
WorkingDirectory=/var/lib/system-monitor
Environment=SYSTEM_MONITOR_ROOT=/usr/share/system-monitor
Environment=SYSTEM_MONITOR_CONFIG_DIR=/etc/system-monitor
Environment=SYSTEM_MONITOR_DATA_DIR=/var/lib/system-monitor
ExecStart=/usr/bin/system-monitor --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
